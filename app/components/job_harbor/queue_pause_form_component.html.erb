<%= form_with url: queues_pauses_path, method: :post, class: "flex flex-wrap items-center gap-2 mb-4" do |f| %>
  <%= f.text_field :name, placeholder: "Queue name", maxlength: JobHarbor::QueueStats::MAX_NAME_LENGTH, required: true, autocomplete: "off",
      "aria-label": "Queue name to pause", class: "select w-full sm:w-64" %>
  <%= f.button "Pause", type: "submit", class: "btn btn-secondary btn-sm" %>
<% end %>
