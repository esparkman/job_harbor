<% content_for :header_actions do %>
  <%= render JobHarbor::JobSearchFormComponent.new(query: params[:q]) %>
<% end %>

<%= render JobHarbor::StatusTabsComponent.new(status: @status, counts: @counts) %>

<%= render JobHarbor::JobFiltersComponent.new(
  class_names: @filter_data[:class_names],
  queue_names: @filter_data[:queue_names],
  current_class: @class_name,
  current_queue: @queue_name,
  current_path: request.path,
  params: request.query_parameters
) %>

<% if @bulk_count.to_i > 0 %>
  <% jobs_label = pluralize(@bulk_count, "#{@status} job") %>
  <% bulk_params = { status: @status, class_name: @class_name.presence, queue_name: @queue_name.presence } %>
  <div class="flex items-center gap-2 mb-4">
    <% if JobHarbor::JobStatus.find(@status)&.bulk_retry? %>
      <%= button_to "Retry #{jobs_label}", retry_all_jobs_path(bulk_params), method: :post, class: "btn btn-secondary btn-sm",
          form: { data: { confirm: "Retry #{jobs_label}? Automatic retry counts are not reset." } } %>
    <% end %>
    <%= button_to "Discard #{jobs_label}", discard_all_jobs_path(bulk_params), method: :delete, class: "btn btn-destructive btn-sm",
        form: { data: { confirm: "Discard #{jobs_label}? This cannot be undone." } } %>
  </div>
<% end %>

<% if @jobs.empty? %>
  <%= render JobHarbor::EmptyStateComponent.new(
    title: "No jobs found",
    description: @status ? "There are no #{@status.humanize.downcase} jobs." : "There are no jobs in the queue.",
    icon: :jobs
  ) %>
<% else %>
  <%= render JobHarbor::JobsTableComponent.new(jobs: @jobs) %>

  <div class="flex flex-wrap items-center justify-between gap-3 mt-4">
    <%= render JobHarbor::PaginationComponent.new(page_info: @page_info) %>
    <%= render JobHarbor::PerPageSelectorComponent.new(
      current_per_page: @per_page,
      current_path: request.path,
      params: request.query_parameters
    ) %>
  </div>
<% end %>
