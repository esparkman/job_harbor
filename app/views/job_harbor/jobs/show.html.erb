<%# Reading a backtrace: a poll would reset its scroll position %>
<% content_for :no_refresh, true %>
<% content_for :header_actions do %>
  <div class="flex items-center gap-2">
    <% if @job.can_retry? %>
      <%= button_to "Retry Job", retry_job_path(@job), method: :post, class: "btn btn-default btn-sm" %>
    <% end %>
    <% if @job.can_discard? %>
      <%= button_to "Discard Job", discard_job_path(@job), method: :delete, class: "btn btn-destructive btn-sm",
          form: { data: { confirm: "Are you sure you want to discard this job?" } } %>
    <% end %>
    <%= link_to "\u2190 Back to Jobs", jobs_path, class: "btn btn-secondary btn-sm" %>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Job Details</h2>
    </div>
    <div class="card-content space-y-1">
      <%= render JobHarbor::InfoLineComponent.new(label: "Status") do %>
        <%= render JobHarbor::BadgeComponent.new(status: @job.status) %>
      <% end %>

      <%= render JobHarbor::InfoLineComponent.new(label: "Job Class") do %>
        <code class="text-sm font-mono"><%= @job.class_name %></code>
      <% end %>

      <%= render JobHarbor::InfoLineComponent.new(label: "Queue") do %>
        <%= link_to @job.queue_name, queue_path(@job.queue_name), class: "link" %>
      <% end %>

      <%= render JobHarbor::InfoLineComponent.new(label: "Priority", value: @job.priority || "Default") %>

      <%= render JobHarbor::InfoLineComponent.new(label: "Active Job ID") do %>
        <code class="text-xs font-mono"><%= @job.active_job_id %></code>
      <% end %>

      <% if @job.worker_name %>
        <%= render JobHarbor::InfoLineComponent.new(label: "Worker", value: @job.worker_name) %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Timing</h2>
    </div>
    <div class="card-content space-y-1">
      <%= render JobHarbor::InfoLineComponent.new(label: "Created At", value: @job.created_at.to_fs(:job_harbor_timestamp_with_zone)) %>

      <% if @job.scheduled_at %>
        <%= render JobHarbor::InfoLineComponent.new(label: "Scheduled At", value: @job.scheduled_at.to_fs(:job_harbor_timestamp_with_zone)) %>
      <% end %>

      <% if @job.finished_at %>
        <%= render JobHarbor::InfoLineComponent.new(label: "Finished At", value: @job.finished_at.to_fs(:job_harbor_timestamp_with_zone)) %>
      <% end %>

      <% if @job.failed_at %>
        <%= render JobHarbor::InfoLineComponent.new(label: "Failed At", value: @job.failed_at.to_fs(:job_harbor_timestamp_with_zone)) %>
      <% end %>
    </div>
  </div>
</div>

<div class="card mt-6">
  <div class="card-header">
    <h2 class="card-title">Arguments</h2>
  </div>
  <div class="card-content">
    <% if @job.job_arguments.empty? %>
      <p class="text-sm text-muted-foreground">No arguments</p>
    <% else %>
      <pre class="code-block"><%= @job.formatted_arguments %></pre>
    <% end %>
    <details class="mt-4">
      <summary class="text-sm text-muted-foreground cursor-pointer">Full payload</summary>
      <pre class="code-block mt-2"><%= @job.formatted_payload %></pre>
    </details>
  </div>
</div>

<% if @job.status == "failed" %>
  <div class="card mt-6 border-t-4 border-t-red-500">
    <div class="card-header">
      <h2 class="card-title text-red-500">Error Details</h2>
    </div>
    <div class="card-content space-y-3">
      <%= render JobHarbor::InfoLineComponent.new(label: "Exception Class") do %>
        <code class="text-sm font-mono"><%= @job.error_class || "Unknown" %></code>
      <% end %>

      <div>
        <div class="text-sm text-muted-foreground mb-1">Error Message</div>
        <div class="text-sm font-medium"><%= @job.error_message || "No error message available" %></div>
      </div>

      <% if @job.error_backtrace.present? %>
        <div>
          <div class="text-sm text-muted-foreground mb-1">Backtrace</div>
          <pre class="code-block max-h-100 overflow-y-auto"><%= @job.error_backtrace %></pre>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
