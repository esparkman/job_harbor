<% content_for :header_actions do %>
  <%= render JobHarbor::JobSearchFormComponent.new(query: params[:q]) %>
<% end %>

<p class="text-sm text-muted-foreground mb-4">
  Found <%= pluralize(@page_info.count, "result") %> for "<%= params[:q] %>"
  <%= link_to "Clear search", jobs_path, class: "link ml-2" %>
</p>

<% if @jobs.empty? %>
  <%= render JobHarbor::EmptyStateComponent.new(
    title: "No results found",
    description: "Try a different search term or check your spelling.",
    icon: :search
  ) %>
<% else %>
  <%= render JobHarbor::JobsTableComponent.new(jobs: @jobs) %>

  <div class="mt-4">
    <%= render JobHarbor::PaginationComponent.new(page_info: @page_info) %>
  </div>
<% end %>
