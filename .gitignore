# Built gem artifacts
*.gem

# Bundler
/.bundle/
vendor/bundle

# Test/dummy app artifacts
test/dummy/db/*.sqlite3
test/dummy/db/*.sqlite3-*
test/dummy/log/*.log*
test/dummy/storage/
test/dummy/tmp/

# General Ruby/Rails
*.rbc
capybara-*.html
.rspec
/coverage/
/spec/tmp/
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Environment and secrets
.env
.env.*
*.pem
*.key

# Tailwind CLI binary (contributors only)
vendor/tailwindcss/
node_modules/

# Claude Code / AI tooling
.claude/
.pensieve/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Documentation artifacts
/doc/
/rdoc/
.yardoc/

# Claude Code personal, machine-specific settings
.claude/settings.local.json

# Machine-local shared-agent symlinks (harness roster; regenerated by install.sh)
.claude/agents/

# Session-local harness markers (review + pipeline gate tokens)
.claude/.last-review
.claude/.current-story
.claude/.small-fix
.claude/.pipeline-block

# Appraisal-style gemfile lockfiles
gemfiles/*.lock
